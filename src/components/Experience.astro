---
import { Icon } from "astro-icon/components";
---

<section id="experience">
  <!-- Hero Stats Section -->
  <div class="experience-hero">
    <div class="hero-content">
      <p class="hero-subtitle">PRODUCT ENGINEERING & AUTOMATION</p>
      <h1 class="hero-title">
        THE FULL-STACK<br />
        <span class="yellow-text-gradient">PRODUCT ENGINEER</span>
      </h1>
      <p class="hero-description">
        I turn product ideas into reliable software, combining frontend,
        backend, mobile, desktop, and AI automation experience.
      </p>

      <div class="stats-container">
        <div class="stat-item">
          <div class="stat-number">4+</div>
          <div class="stat-label">YEARS OF EXPERIENCE</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">3K+</div>
          <div class="stat-label">ACTIVE PRODUCT USERS</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">7K+</div>
          <div class="stat-label">PRODUCT DOWNLOADS</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Professional Journey Section -->
  <div class="journey-section">
    <div class="journey-header">
      <p class="journey-subtitle">MEET THE DEVELOPER</p>
      <h2 class="journey-title">RAFA CABANILLAS</h2>
      <p class="journey-description">
        Full-stack Product Engineer focused on shipping useful products and
        automating complex workflows. I work across web, mobile, desktop, and
        AI-powered solutions.
      </p>

      <a href="/about" class="common-button">
        <span>Learn More About Me</span>
        <Icon name="arrow-right" size={20} class="button-icon" />
      </a>
    </div>
  </div>

  <!-- Experience Timeline Section -->
  <div class="timeline-section">
    <div class="timeline-header">
      <h2 class="timeline-title">PROFESSIONAL JOURNEY</h2>
      <p class="timeline-subtitle">
        A path of excellence and continuous growth
      </p>
    </div>

    <div class="timeline-container">
      <!-- UST (Current) -->
      <div class="timeline-item current">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="timeline-period">May 2025 - Present</div>
          <a
            class="position-title"
            href="https://ust.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            UST - L3 Support Engineer
            <Icon class="external-link" name="arrow-up-right" size="1.2rem" />
          </a>
          <div class="company-info">
            <p class="company-description">
              Promoted to Level 3 after automating incident management for more
              than 35,000 users using GenAI.
            </p>
            <ul class="achievement">
              <li>
                Built a ServiceNow extension to improve incident management.
              </li>
              <li>
                Built an AI PDF compressor to streamline recruiter workflows.
              </li>
              <li>
                Supported critical workflows for a global staffing organization.
              </li>
            </ul>
          </div>
          <div class="tech-stack">
            <span class="tech-pill">GenAI</span>
            <span class="tech-pill">ServiceNow</span>
            <span class="tech-pill">AI Automation</span>
            <span class="tech-pill">Azure DevOps</span>
            <span class="tech-pill">REST</span>
            <span class="tech-pill">Git</span>
          </div>
        </div>
      </div>

      <!-- Freelance -->
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="timeline-period">Oct 2023 - Present</div>
          <a
            class="position-title"
            href="https://seltore.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            SELTORE LLC - Software Engineer
            <Icon class="external-link" name="arrow-up-right" size="1.2rem" />
          </a>
          <div class="company-info">
            <p class="company-description">
              I design, build, and launch end-to-end products for clients and
              independent ventures across web, mobile, and desktop.
            </p>
            <ul class="achievement">
              <li>
                Built Next.js business portals with self-service content editing.
              </li>
              <li>
                Used LLM agents, Cursor, and Claude Code to reduce delivery time
                from weeks to days.
              </li>
              <li>
                Launched independent products including MoneyBoard and True
                Resonance.
              </li>
            </ul>
          </div>
          <div class="tech-stack">
            <span class="tech-pill">React</span>
            <span class="tech-pill">React Native</span>
            <span class="tech-pill">TypeScript</span>
            <span class="tech-pill">Rust</span>
            <span class="tech-pill">Tauri</span>
            <span class="tech-pill">Next.js</span>
            <span class="tech-pill">LLM Agents</span>
            <span class="tech-pill">Claude Code</span>
          </div>
        </div>
      </div>

      <!-- Mobbeel -->
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="timeline-period">Aug 2023 - Aug 2024</div>
          <a
            class="position-title"
            href="https://www.mobbeel.com"
            target="_blank"
            rel="noopener noreferrer"
          >
            Mobbeel Solutions SL - Frontend Developer
            <Icon class="external-link" name="arrow-up-right" size="1.2rem" />
          </a>
          <div class="company-info">
            <p class="company-description">
              Built onboarding flows for biometric identity platforms used in
              government elections and airport security.
            </p>
            <ul class="achievement">
              <li>
                Developed an automation portal using Angular, cutting tenant
                configuration time by 75%.
              </li>
              <li>
                Collaborated with product and backend teams to deliver secure,
                accessible identity experiences.
              </li>
            </ul>
          </div>
          <div class="tech-stack">
            <span class="tech-pill">Angular</span>
            <span class="tech-pill">React</span>
            <span class="tech-pill">TypeScript</span>
            <span class="tech-pill">Jest</span>
            <span class="tech-pill">Playwright</span>
            <span class="tech-pill">Gitflow</span>
            <span class="tech-pill">WCAG</span>
          </div>
        </div>
      </div>

      <!-- Wa.Works -->
      <div class="timeline-item">
        <div class="timeline-marker"></div>
        <div class="timeline-content">
          <div class="timeline-period">Nov 2021 - Mar 2022</div>
          <a
            class="position-title"
            href="https://thehub.io/startups/waworks"
            target="_blank"
            rel="noopener noreferrer"
          >
            Wa.Works - React Developer (Bergen, Norway)
            <Icon class="external-link" name="arrow-up-right" size="1.2rem" />
          </a>
          <div class="company-info">
            <p class="company-description">
              React development in an international team (Norway). Delivered
              features with
              <strong>Hooks</strong>, <strong>Redux</strong>, <strong
                >Context API</strong
              > and <strong>TypeScript</strong>, following <strong>WCAG</strong>
              standards.
            </p>
            <ul class="achievement">
              <li>Presented the final project to the CEO</li>
              <li>Supported teammates via mentoring & pair programming</li>
            </ul>
          </div>
          <div class="tech-stack">
            <span class="tech-pill">React</span>
            <span class="tech-pill">Redux</span>
            <span class="tech-pill">TypeScript</span>
            <span class="tech-pill">Context API</span>
            <span class="tech-pill">Accessibility</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Call to Action Section -->
  <div class="cta-section">
    <div class="cta-content">
      <h2 class="cta-title">BECOME A CLIENT!</h2>
      <p class="cta-description">
        Ready to take your project to the next level? Let's work together to
        create exceptional web solutions.
      </p>
      <a href="/contact" class="common-button">
        <span>CONTACT ME!</span>
        <Icon name="arrow-right" size={20} class="button-icon" />
      </a>
    </div>
  </div>

  <style>
    #experience {
      background: var(--background-dark);
    }

    /* Hero Section Styles */
    .experience-hero {
      padding-top: 4rem;
      background:
        linear-gradient(135deg, rgba(30, 56, 96, 0.95), rgba(45, 74, 90, 0.85)),
        url("/images/modern-office-setup.jpg") center/cover;
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      position: relative;
    }

    .hero-content {
      max-width: 900px;
      padding: 2rem;
    }

    .hero-subtitle {
      font-size: 0.9rem;
      letter-spacing: 2px;
      color: var(--primary-color);
      margin-bottom: 1rem;
      font-weight: 600;
    }

    .hero-title {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 700;
      line-height: 1.1;
      margin-bottom: 2rem;
      color: white;
    }

    .hero-description {
      font-size: 1.1rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 3rem;
      max-width: 700px;
      margin: 0 auto 3rem auto;
    }

    .stats-container {
      display: flex;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .stat-label {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.8);
      letter-spacing: 1px;
      font-weight: 500;
    }

    /* Journey Section */
    .journey-section {
      background: var(--background-light);
      padding: 5rem 2rem;
      color: white;
    }

    .journey-header {
      max-width: 1000px;
      margin: 0 auto;
      text-align: center;
    }

    .journey-subtitle {
      font-size: 0.9rem;
      letter-spacing: 2px;
      color: var(--primary-color);
      margin-bottom: 1rem;
      font-weight: 600;
    }

    .journey-title {
      font-size: clamp(2.5rem, 4vw, 3.5rem);
      font-weight: 700;
      color: #d4af37;
      margin-bottom: 2rem;
      letter-spacing: 1px;
    }

    .journey-description {
      font-size: 1.1rem;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 2rem;
      text-align: center;
    }

    /* Timeline Section */
    .timeline-section {
      padding: 5rem 2rem;
      background: var(--background-dark);
    }

    .timeline-header {
      text-align: center;
      margin-bottom: 4rem;
    }

    .timeline-title {
      font-size: clamp(2rem, 3vw, 2.8rem);
      font-weight: 700;
      color: white;
      margin-bottom: 1rem;
    }

    .timeline-subtitle {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.7);
      font-weight: 400;
    }

    .timeline-container {
      max-width: 1000px;
      margin: 0 auto;
      position: relative;
    }

    .timeline-container::before {
      content: "";
      position: absolute;
      left: 2rem;
      top: 0;
      bottom: 0;
      width: 2px;
      background: linear-gradient(
        to bottom,
        var(--primary-color),
        rgba(94, 232, 232, 0.3)
      );
    }

    .timeline-item {
      position: relative;
      margin-bottom: 3rem;
      padding-left: 5rem;
    }

    .timeline-item.current .timeline-marker {
      background: #2ecc71;
      box-shadow: 0 0 20px rgba(46, 204, 113, 0.5);
    }

    .timeline-marker {
      position: absolute;
      left: 1.2rem;
      top: 1rem;
      width: 1.6rem;
      height: 1.6rem;
      background: var(--primary-color);
      border-radius: 50%;
      border: 3px solid var(--background-dark);
      z-index: 2;
    }

    .timeline-content {
      background: rgba(255, 255, 255, 0.05);
      padding: 2rem;
      border-radius: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }

    .timeline-content:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .timeline-period {
      font-size: 0.9rem;
      color: var(--primary-color);
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .position-title {
      font-size: 1.4rem;
      font-weight: 700;
      color: white;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
    }

    .position-title:hover {
      color: var(--primary-color);
    }

    .external-link {
      color: var(--primary-color);
      opacity: 0.7;
      transition: opacity 0.3s ease;
    }

    .position-title:hover .external-link {
      opacity: 1;
      transform: translate(2px, -3px);
    }

    .company-info {
      margin-bottom: 1.5rem;
    }

    .company-description {
      font-size: 1rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: 1rem;
    }

    .achievement {
      font-size: 0.95rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.9);
      background: rgba(255, 255, 255, 0.05);
      padding: 1rem;
      border-radius: 0.5rem;
      border-left: 3px solid var(--primary-color);
      padding-left: 2rem;
    }

    .tech-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-top: 1.5rem;
    }

    .tech-pill {
      background: rgba(94, 232, 232, 0.2);
      color: var(--primary-color);
      padding: 0.4rem 0.8rem;
      border-radius: 1rem;
      font-size: 0.8rem;
      font-weight: 500;
      border: 1px solid rgba(94, 232, 232, 0.3);
      transition: all 0.3s ease;
    }

    .tech-pill:hover {
      background: rgba(94, 232, 232, 0.3);
      transform: translateY(-2px);
    }

    /* Call to Action Section */
    .cta-section {
      background: var(--background-light);
      padding: 4rem 2rem;
      text-align: center;
      color: white;
    }

    .cta-content {
      max-width: 600px;
      margin: 0 auto;
    }

    .cta-title {
      font-size: clamp(2rem, 3vw, 2.5rem);
      font-weight: 700;
      margin-bottom: 1.5rem;
      color: white;
    }

    .cta-description {
      font-size: 1.1rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 2rem;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
      .experience-hero {
        min-height: 60vh;
        padding-top: 4rem;
        padding-left: 1rem;
        padding-right: 1rem;
        padding-bottom: 2rem;
      }

      .hero-content {
        padding: 1rem;
      }

      .stats-container {
        gap: 2rem;
        flex-direction: column;
      }

      .journey-section,
      .timeline-section {
        padding: 3rem 1rem;
      }

      .timeline-container::before {
        left: 1rem;
      }

      .timeline-item {
        padding-left: 3rem;
      }

      .timeline-marker {
        left: 0.2rem;
      }

      .timeline-content {
        padding: 1.5rem;
      }

      .position-title {
        font-size: 1.2rem;
      }

      .company-description {
        font-size: 0.9rem;
      }

      .achievement {
        font-size: 0.8rem;
        padding-left: 1.5rem;
      }

      .tech-stack {
        justify-content: center;
      }
    }
  </style>
</section>
